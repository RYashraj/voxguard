# =============================================================================
# VoxGuard — Environment Variables Reference
# =============================================================================
# Copy this file to .env.local (frontend) or set these vars in your shell
# before running the backend.
#
# DO NOT commit real values. This file contains only placeholders.
# =============================================================================


# -----------------------------------------------------------------------------
# FRONTEND (Next.js) — prefix with NEXT_PUBLIC_ to expose to browser
# -----------------------------------------------------------------------------

# WebSocket URL for the live risk stream from the backend.
# In production, change to wss://your-domain.com/ws/session
# Used in: app/page.tsx via useRiskSocket hook
NEXT_PUBLIC_RISK_WS_URL=ws://localhost:8000/ws/session

# Token for WebSocket connection authentication
# Used in: app/page.tsx (frontend) and backend/app/main.py (backend)
NEXT_PUBLIC_VOXGUARD_WS_TOKEN=super_secret_token_123

# HTTP base URL for REST API calls (start-simulation, stop-simulation, etc.)
# In production, change to https://your-domain.com
# Used in: app/page.tsx → handleStartCall() fetch()
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google OAuth (Phase 4 — NextAuth.js)
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Used in: app/api/auth/[...nextauth]/route.ts
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth.js secret — generate with: openssl rand -base64 32
# Used in: NextAuth session signing / JWT encryption
NEXTAUTH_SECRET=replace-with-32-char-random-string

# The canonical URL of your deployment (no trailing slash)
# Dev: http://localhost:3000 | Prod: https://your-domain.com
# Used in: NextAuth redirect URLs and callback validation
NEXTAUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# BACKEND (FastAPI / Python)
# -----------------------------------------------------------------------------

# ML inference mode. Controls which analyzer is used per audio chunk.
#   real  → Spectra-AASIST3 model (requires PyTorch + GPU or CPU-only install)
#   stub  → Simulated scores via analyze_chunk_stub() — no ML deps needed
# Used in: backend/app/ml/analyzer.py → analyze_chunk_dispatch()
VOXGUARD_ML_MODE=stub

# WebSocket authentication token for the backend to verify incoming connections.
# This MUST match NEXT_PUBLIC_VOXGUARD_WS_TOKEN on the frontend.
VOXGUARD_WS_TOKEN=super_secret_token_123

# Spectra-AASIST3 model identifier (HuggingFace Hub ID or local path).
# Default "lab260/Spectra-AASIST3" downloads from HuggingFace automatically.
# Set to a local path like /models/Spectra-AASIST3 to avoid network calls.
# Used in: backend/app/ml/ml_model.py → SpectraAASISTDetector.__init__()
SPECTRA_MODEL_PATH=lab260/Spectra-AASIST3

# SQLite database file path for session history logging.
# Defaults to backend/data/voxguard.db (relative to session_logger.py).
# Set this to an absolute path if you need the DB in a specific location.
# Used in: backend/app/db/session_logger.py → get_db_path()
VOXGUARD_DB_PATH=

# Backend server port.
# NOTE: backend/main.py currently hardcodes port=8000 and does NOT read this
# env var automatically. If you need a different port, change it in backend/main.py
# OR run uvicorn manually: uvicorn app.main:app --port $BACKEND_PORT
# Default: 8000
BACKEND_PORT=8000


# -----------------------------------------------------------------------------
# STANDALONE ML SCRIPT (Model/ml_model.py — for Nandini/Hetvi dev use only)
# These are NOT used by the FastAPI backend — only by the standalone script.
# -----------------------------------------------------------------------------

# Path to the test WAV file for the standalone exploration script.
# Default: test_audio/clone_2.wav (relative to script execution directory)
# Used in: ml/ml_model.py → AUDIO_FILE
VOXGUARD_TEST_AUDIO_PATH=test_audio/clone_2.wav

# Local path to a cached Spectra-AASIST3 model directory (optional).
# If unset, defaults to "lab260/Spectra-AASIST3" (downloads from HuggingFace).
# Used in: Model/ml_model.py → test_spectra()
# (Same var as SPECTRA_MODEL_PATH above — shared for consistency)
# SPECTRA_MODEL_PATH=/path/to/local/Spectra-AASIST3
